rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPERS ====================

    // Check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Check if the user ID matches the authenticated user
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Check if the user is a participant in a thread (for existing data)
    function isThreadParticipant(threadData) {
      return isAuth() && threadData.participantUids.hasAny([request.auth.uid]);
    }

    // Check if the request data includes the user as participant (for creates)
    function isCreatingThreadParticipant() {
      return isAuth() && request.resource.data.participantUids.hasAny([request.auth.uid]);
    }

    // ==================== USERS ====================

    // Users can read any profile (needed for chat list display)
    // Users can only write their own profile
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);

      // Contacts subcollection - stores reverse contact links
      // e.g. User A writes to users/B/contacts/A when adding B as a contact
      match /contacts/{contactId} {
        // Any authenticated user can read (needed for mutual contact verification)
        allow read: if isAuth();
        // Any authenticated user can create (needed for reverse-link batch write)
        // The uid field must match the authenticated user's UID
        allow create: if isAuth()
          && request.resource.data.uid == request.auth.uid;
        // Owner of the user doc OR the contact themselves can update (mutual flag)
        allow update: if isOwner(uid)
          || (isAuth() && request.auth.uid == contactId);
        // Only the owner can delete their own contacts
        allow delete: if isOwner(uid);
      }
    }

    // Username mappings - anyone authenticated can read
    match /usernames/{username} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth() && request.auth.uid == resource.data.uid;
    }

    // ==================== THREADS (Chat) ====================

    // Thread collection - users can only access threads they participate in
    match /threads/{threadId} {

      // Thread metadata
      // CREATE: user must be in the participantUids array of the new document
      // READ/UPDATE: user must be in the participantUids array of the existing document
      allow create: if isAuth() && isCreatingThreadParticipant();
      allow read: if isAuth() && isThreadParticipant(resource.data);
      allow update: if isAuth() && isThreadParticipant(resource.data)
        && isThreadParticipant(request.resource.data);
      allow delete: if isAuth() && isThreadParticipant(resource.data);

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuth() && isThreadParticipant(
          get(/databases/$(database)/documents/threads/$(threadId)).data
        );
        allow create: if isAuth()
          && isThreadParticipant(get(/databases/$(database)/documents/threads/$(threadId)).data)
          && request.resource.data.senderUid == request.auth.uid;
        allow update: if isAuth()
          && isThreadParticipant(get(/databases/$(database)/documents/threads/$(threadId)).data)
          && resource.data.senderUid == request.auth.uid;
        allow delete: if isAuth()
          && resource.data.senderUid == request.auth.uid;
      }
    }

    // ==================== CALLS ====================

    // Call records - users can read their own calls, create new ones
    match /call_log/{callId} {
      allow read: if isAuth()
        && (resource.data.callerUid == request.auth.uid
          || resource.data.calleeUid == request.auth.uid);
      allow create: if isAuth()
        && (request.resource.data.callerUid == request.auth.uid
          || request.resource.data.calleeUid == request.auth.uid);
      allow update: if isAuth()
        && (resource.data.callerUid == request.auth.uid
          || resource.data.calleeUid == request.auth.uid);
      allow delete: if isAuth()
        && (resource.data.callerUid == request.auth.uid
          || resource.data.calleeUid == request.auth.uid);
    }

    // ==================== CALL SIGNALING ====================

    // WebRTC signaling - temporary documents for call setup
    match /calls_signaling/{callId} {
      allow read: if isAuth()
        && (resource.data.callerUid == request.auth.uid
          || resource.data.targetUid == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth()
        && (resource.data.callerUid == request.auth.uid
          || resource.data.targetUid == request.auth.uid);
      allow delete: if isAuth()
        && (resource.data.callerUid == request.auth.uid
          || resource.data.targetUid == request.auth.uid);
    }

    // ==================== FCM TOKENS ====================
    // Store FCM tokens for push notifications

    match /fcmTokens/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // ==================== STATUSES ====================
    // Status / stories feature

    match /statuses/{statusId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth()
        && resource.data.uid == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.uid == request.auth.uid;
    }

    // ==================== USER PRESENCE ====================
    // Online / last-seen presence data

    match /user_presence/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }
  }
}
